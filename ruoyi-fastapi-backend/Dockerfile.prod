FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=UTC
WORKDIR /app
ARG DEBIAN_MIRROR=https://mirrors.cloud.tencent.com/debian
RUN sed -i "s|http://deb.debian.org/debian|$DEBIAN_MIRROR|g" /etc/apt/sources.list.d/debian.sources && apt-get update && apt-get install -y --no-install-recommends ffmpeg gcc libpq-dev && rm -rf /var/lib/apt/lists/*
COPY requirements-pg.txt pyproject.toml ./
COPY cli ./cli
RUN apt-get update && apt-get install -y --no-install-recommends libc6-dev && rm -rf /var/lib/apt/lists/*
ARG PIP_FIND_LINKS
ARG PIP_NO_INDEX
RUN pip install --no-cache-dir -r requirements-pg.txt
COPY . .
RUN sed -i 's/^env = dev[[:space:]]*$/env = prod/' alembic.ini && groupadd -g 10001 higgsfield && useradd -u 10001 -g higgsfield -m higgsfield && mkdir -p /app/logs /app/vf_admin && chown -R higgsfield:higgsfield /app/vf_admin /app/logs
USER higgsfield
CMD ["python","app.py","--env","prod"]
