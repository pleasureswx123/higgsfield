{
  "name": "higgsfield-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:creation": "node --test tests/creation-draft.test.cjs",
    "test:project-navigation": "node --test tests/project-navigation.test.cjs tests/project-preference-editor.test.cjs tests/project-collections.test.cjs tests/project-view-preference.test.cjs tests/content-view.test.cjs",
    "test:usage": "node --test tests/usage-summary.test.cjs tests/billing.test.cjs tests/budget-status.test.cjs",
    "test:generations": "node --test tests/generations.test.cjs tests/generation-detail.test.cjs tests/event-stream.test.cjs tests/generation-cancel.test.cjs tests/generation-archive-retry.test.cjs tests/generation-submit.test.cjs tests/billing.test.cjs tests/budget-status.test.cjs",
    "lint": "eslint .",
    "format:check": "prettier --check src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@tabler/icons-vue": "^3.31.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "element-plus": "^2.9.7",
    "pdfjs-dist": "6.4.299",
    "pinia": "^3.0.1",
    "reka-ui": "^2.2.0",
    "tailwind-merge": "^3.0.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.4",
    "vue-tsc": "^2.2.8"
  },
  "engines": {
    "node": ">=22.14.0",
    "pnpm": "11.28.6"
  }
}
